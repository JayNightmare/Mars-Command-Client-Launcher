# Local maintainer tooling only. Never commit real secrets.
CURSEFORGE_API_KEY=
CURSEFORGE_API_URL=https://api.curseforge.com

# Optional; leave unset to use the public main-branch overrides.
# Release workflow sets an immutable URL pinned to the checked-out source commit.
# MARS_OVERRIDE_BASE_URL=https://raw.githubusercontent.com/OWNER/REPO/COMMIT/modpack/Mars%20Client/overrides

# Batch 1 community/account public deployment configuration.
# Export these to the Rust build environment (or runtime process environment).
# This .env file is NOT automatically loaded by the desktop account commands.
# API server origin/base WITHOUT /api.
MARS_COMMUNITY_API_BASE=https://api.nexusgit.info
# Website origin/base: desktop verification must match <base>/auth/login?requestId=...
MARS_WEBSITE_BASE=https://mars.nexusgit.info
# Explicit recipient required; no default and no client-side role grants.
MARS_SPONSORS_URL=
